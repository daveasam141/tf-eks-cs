pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins: agent
spec:
  serviceAccountName: jenkins
  containers:
  - name: jnlp
    image: davidasam141/jenkinscustom-agent-2
    env:
    - name: CONTAINER_ENV_VAR
      value: ""
    resources:
      requests:
        memory: "512Mi"
        cpu: "500m"
      limits:
        memory: "2Gi"
        cpu: "2"
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command:
    - sleep
    args:
    - "9999999"
    resources:
      requests:
        memory: "512Mi"
        cpu: "500m"
      limits:
        memory: "2Gi"
        cpu: "2"
    volumeMounts:
    - name: docker-config
      mountPath: /kaniko/.docker
  volumes:
  - name: docker-config
    emptyDir: {}
"""
        }
    }
    
    environment {
        // Docker Hub configuration
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        IMAGE_NAME = 'cicd-learning-app'
        REGISTRY = 'docker.io'
        
        // EKS/Kubernetes configuration
        NAMESPACE = 'cicd-app'
        APP_NAME = 'cicd-app'
    }
    
    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "Checking out code from ${env.GIT_URL}"
                    checkout scm
                    
                    // Determine image tag from branch name
                    def branchName = env.BRANCH_NAME ?: env.GIT_BRANCH?.replaceAll('origin/', '') ?: 'latest'
                    env.IMAGE_TAG = (branchName == 'main' || branchName == 'master') ? 'latest' : branchName
                    echo "Image tag set to: ${env.IMAGE_TAG}"
                }
            }
        }
        
        stage('Test') {
            steps {
                dir('CICD/app') {
                    script {
                        echo "Running Python tests..."
                        sh '''
                            python3 -m venv venv
                            . venv/bin/activate
                            pip install --upgrade pip
                            pip install -r requirements.txt
                            pip install pytest pytest-cov flake8
                            python -m pytest test_app.py -v --cov=app --cov-report=term-missing
                            flake8 app.py test_app.py --max-line-length=100 --exclude=__pycache__ || true
                        '''
                    }
                }
            }
        }
        
        stage('Build and Push Image') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        env.FULL_IMAGE_NAME = "${DOCKER_USER}/${IMAGE_NAME}:${env.IMAGE_TAG}"
                        echo "Building and pushing image: ${env.FULL_IMAGE_NAME}"
                        
                        // Build and push with Kaniko
                        container('kaniko') {
                            sh """
                                echo '{"auths":{"https://index.docker.io/v1/":{"username":"${DOCKER_USER}","password":"${DOCKER_PASS}"}}}' > /kaniko/.docker/config.json
                                /kaniko/executor \
                                    --context=dir://\${WORKSPACE}/CICD/app \
                                    --dockerfile=CICD/app/Dockerfile \
                                    --destination=${env.FULL_IMAGE_NAME} \
                                    --destination=${DOCKER_USER}/${IMAGE_NAME}:${env.BUILD_NUMBER} \
                                    --build-arg=APP_VERSION=${env.BUILD_NUMBER} \
                                    --cache=true
                            """
                        }
                    }
                }
            }
        }
        
        stage('Security Scan') {
            steps {
                script {
                    echo "Scanning image for vulnerabilities..."
                    sh """
                        trivy image --exit-code 0 --severity HIGH,CRITICAL ${env.FULL_IMAGE_NAME} || true
                    """
                }
            }
        }
        
        stage('Deploy to EKS') {
            steps {
                script {
                    echo "Deploying to EKS namespace: ${NAMESPACE}"
                    
                    // Verify cluster access
                    echo "Verifying cluster access..."
                    sh "kubectl version --client"
                    
                    // Verify namespace exists
                    echo "Verifying namespace ${NAMESPACE} exists..."
                    sh "kubectl get namespace ${NAMESPACE}"
                    
                    // Update deployment with new image and apply manifests
                    dir('CICD/jenkins/eks') {
                        withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                            if (!env.FULL_IMAGE_NAME) {
                                env.FULL_IMAGE_NAME = "${DOCKER_USER}/${IMAGE_NAME}:${env.IMAGE_TAG}"
                            }
                            
                            // Update image in deployment.yaml
                            sh """
                                perl -i -pe "s|image:.*${IMAGE_NAME}.*|image: ${env.FULL_IMAGE_NAME}|g" deployment.yaml
                                
                                # Update APP_VERSION with build number
                                perl -i -pe "s|(name: APP_VERSION\\s+value: )\".*\"|\1\"${env.BUILD_NUMBER}\"|g" deployment.yaml || true
                            """
                        
                            // Apply manifests
                            echo "Applying Kubernetes manifests..."
                            sh """
                                kubectl apply -f deployment.yaml
                                kubectl apply -f service.yaml
                            """
                            
                            // Apply ingress if it exists
                            sh """
                                if [ -f ingress.yaml ]; then
                                    kubectl apply -f ingress.yaml
                                fi
                            """
                        }
                    }
                    
                    // Wait for rollout
                    echo "Waiting for deployment rollout to complete..."
                    sh """
                        kubectl rollout status deployment/${APP_NAME} -n ${NAMESPACE} --timeout=5m || echo "Warning: Rollout status check timed out"
                    """
                    
                    // Show deployment status
                    echo "Deployment status:"
                    sh "kubectl get pods -n ${NAMESPACE} -l app=${APP_NAME}"
                }
            }
        }
    }
    
    post {
        success {
            script {
                echo "Pipeline succeeded! Application deployed to EKS"
                echo "Image: ${env.FULL_IMAGE_NAME ?: 'N/A'}"
                echo "Build Number: ${env.BUILD_NUMBER}"
                echo "Namespace: ${NAMESPACE}"
            }
        }
        failure {
            script {
                echo "Pipeline failed! Check logs above for details."
            }
        }
        always {
            echo "Pipeline completed"
        }
    }
}